var float orLow = na
var float closeAtOREnd = na
var int biasDirection = 0
var int eodDirection = 0
var bool orComplete = false
var bool biasMarked = false
var bool eodMarked = false
var float todayClose = na
var float todayORH = na
var float todayORL = na

// ═══════════════════════════════════════════════════════════════════════════════
// FIB RETRACEMENT STATE VARIABLES
// ═══════════════════════════════════════════════════════════════════════════════

var int breakoutState = 0
var bool breakoutDetected = false
var int breakoutBar = na
var float breakoutClosePrice = na

var bool pivotDetected = false
var float pivotPrice = na
var int pivotBar = na
var int marketCloseBarToday = na
var bool fibsDrawn = false
var float fibAnchor1 = na
var float fibAnchor2 = na

var float fib_0 = na
var float fib_236 = na
var float fib_382 = na
var float fib_500 = na
var float fib_618 = na
var float fib_786 = na
var float fib_100 = na

var array<line> fibLines = array.new_line(0)
var array<label> fibLabels = array.new_label(0)
var line entryZoneLine1 = na
var line entryZoneLine2 = na
var linefill entryZoneFill = na

// Fib stats persistent counters
var int totalFibSetups = 0
var int countTouch38 = 0
var int countTouch50 = 0
var int countTouch61 = 0
var int countTouch78 = 0
var int winsFrom38 = 0
var int winsFrom50 = 0
var int winsFrom61 = 0
var int winsFrom78 = 0
var int totalFailures = 0
var int totalWins = 0
var int totalLosses = 0
var int totalOpens = 0

// Fib stats daily state
var bool fibSessionCountedToday = false
var bool touched38Today = false
var bool touched50Today = false
var bool touched61Today = false
var bool touched78Today = false
var bool fibResolvedToday = false
var int fibResultToday = 0
var bool fibStatsCommittedToday = false

if newDay
    meanHigh := na
    meanLow := na
    meanLine := na
    orHigh := na
    orLow := na
    closeAtOREnd := na
    biasDirection := 0
    eodDirection := 0
    orComplete := false
    biasMarked := false
    eodMarked := false
    todayClose := na
    todayORH := na
    todayORL := na
    
    // Fib resets
    breakoutState := 0
    breakoutDetected := false
    breakoutBar := na
    breakoutClosePrice := na
    pivotDetected := false
    pivotPrice := na
    pivotBar := na
    fibsDrawn := false
    fibAnchor1 := na
    fibAnchor2 := na
    fib_0 := na
    fib_236 := na
    fib_382 := na
    fib_500 := na
    fib_618 := na
    fib_786 := na
    fib_100 := na

    // Fib stats daily resets
    fibSessionCountedToday := false
    touched38Today := false
    touched50Today := false
    touched61Today := false
    touched78Today := false
    fibResolvedToday := false
    fibResultToday := 0
    fibStatsCommittedToday := false

    // Clean up fib lines and labels
    if i_showHistoricalFibs
        // Keep lines but finalize their positions at the PREVIOUS close index
        if array.size(fibLines) > 0
            // If marketCloseBarToday is na (e.g. data gap), use the last bar of yesterday
            int finalX = na(marketCloseBarToday) ? bar_index[1] : marketCloseBarToday
            for i = 0 to array.size(fibLines) - 1
                line.set_x2(array.get(fibLines, i), finalX)
            array.clear(fibLines)
        if array.size(fibLabels) > 0
            int finalX = na(marketCloseBarToday) ? bar_index[1] : marketCloseBarToday
            for i = 0 to array.size(fibLabels) - 1
                label.set_x(array.get(fibLabels, i), finalX)
            array.clear(fibLabels)
        entryZoneFill := na
        entryZoneLine1 := na
        entryZoneLine2 := na
    else
        // Delete everything if not showing historical
        if array.size(fibLines) > 0
            for i = 0 to array.size(fibLines) - 1
                line.delete(array.get(fibLines, i))
            array.clear(fibLines)
        if array.size(fibLabels) > 0
            for i = 0 to array.size(fibLabels) - 1
                label.delete(array.get(fibLabels, i))
            array.clear(fibLabels)
        if not na(entryZoneFill)
            linefill.delete(entryZoneFill)
            entryZoneFill := na
        if not na(entryZoneLine1)
            line.delete(entryZoneLine1)
            entryZoneLine1 := na
        if not na(entryZoneLine2)
            line.delete(entryZoneLine2)
            entryZoneLine2 := na
            
    // RESET THIS LAST so the cleanup loop above can use the previous day's value
    marketCloseBarToday := na
if inMeanWindow
    meanHigh := na(meanHigh) ? high : math.max(meanHigh, high)
    meanLow := na(meanLow) ? low : math.min(meanLow, low)
    meanLine := (meanHigh + meanLow) / 2.0

if inORWindow
    orHigh := na(orHigh) ? high : math.max(orHigh, high)
    orLow := na(orLow) ? low : math.min(orLow, low)
    closeAtOREnd := close

if not inORWindow and inORWindow[1]
    orComplete := true
    todayORH := orHigh
    todayORL := orLow

if isBiasCheckBar and not na(meanLine) and not biasMarked
    biasDirection := closeAtOREnd > meanLine ? 1 : -1
    biasMarked := true

if isEODCheckBar and not na(meanLine) and not eodMarked
    float finalClose = close[1] 
    eodDirection := close > meanLine ? 1 : -1
    todayClose := close
    eodMarked := true

// Capture the bar index at market close
if (inEODCheckWindow and na(marketCloseBarToday)) or (not isRTH and isRTH[1])
    marketCloseBarToday := bar_index

// ═══════════════════════════════════════════════════════════════════════════════
// BREAKOUT DETECTION
// ═══════════════════════════════════════════════════════════════════════════════

bool canDetectBreakout = orComplete and not breakoutDetected and i_showFibSetup

bool longBreakoutSignal = canDetectBreakout and close > orHigh and close[1] <= orHigh
bool shortBreakoutSignal = canDetectBreakout and close < orLow and close[1] >= orLow

if longBreakoutSignal
    breakoutState := 1
    breakoutDetected := true
    breakoutBar := bar_index
    breakoutClosePrice := close

if shortBreakoutSignal
    breakoutState := -1
    breakoutDetected := true
    breakoutBar := bar_index
    breakoutClosePrice := close

// ═══════════════════════════════════════════════════════════════════════════════
// PIVOT DETECTION
// ═══════════════════════════════════════════════════════════════════════════════

int pivotN = i_pivotStrength
bool canDetectPivot = breakoutDetected and not pivotDetected and not fibsDrawn

// For LONG: look for swing high
if canDetectPivot and breakoutState == 1 and f_isSwingHigh(pivotN)
    int candidatePivotBar = bar_index - pivotN
    float candidatePivotPrice = high[pivotN]
    
    bool afterBreakout = candidatePivotBar > breakoutBar
    bool meetsStrictCriteria = not i_strictPivotValidation or candidatePivotPrice > orHigh
    
    if afterBreakout and meetsStrictCriteria
        pivotDetected := true
        pivotBar := candidatePivotBar
        pivotPrice := candidatePivotPrice

// For SHORT: look for swing low
if canDetectPivot and breakoutState == -1 and f_isSwingLow(pivotN)
    int candidatePivotBar = bar_index - pivotN
    float candidatePivotPrice = low[pivotN]
    
    bool afterBreakout = candidatePivotBar > breakoutBar
    bool meetsStrictCriteria = not i_strictPivotValidation or candidatePivotPrice < orLow
    
    if afterBreakout and meetsStrictCriteria
        pivotDetected := true
        pivotBar := candidatePivotBar
        pivotPrice := candidatePivotPrice

// ═══════════════════════════════════════════════════════════════════════════════
// FIB CALCULATION & DRAWING
// ═══════════════════════════════════════════════════════════════════════════════

if pivotDetected and not fibsDrawn
    if breakoutState == 1
        fibAnchor1 := orLow
        fibAnchor2 := pivotPrice
    else
        fibAnchor1 := orHigh
        fibAnchor2 := pivotPrice
    
    float fibRange = math.abs(fibAnchor2 - fibAnchor1)
    
    if breakoutState == 1
        fib_0 := fibAnchor2
        fib_236 := fibAnchor2 - fibRange * 0.236
        fib_382 := fibAnchor2 - fibRange * 0.382
        fib_500 := fibAnchor2 - fibRange * 0.500
        fib_618 := fibAnchor2 - fibRange * 0.618
        fib_786 := fibAnchor2 - fibRange * 0.786
        fib_100 := fibAnchor1
    else
        fib_0 := fibAnchor2
        fib_236 := fibAnchor2 + fibRange * 0.236
        fib_382 := fibAnchor2 + fibRange * 0.382
        fib_500 := fibAnchor2 + fibRange * 0.500
        fib_618 := fibAnchor2 + fibRange * 0.618
        fib_786 := fibAnchor2 + fibRange * 0.786
        fib_100 := fibAnchor1
    
    color fibColor = breakoutState == 1 ? i_fibLongColor : i_fibShortColor
    
    int startX = pivotBar
    int endX = bar_index + i_fibExtendBars
    
    // Draw 0% level
    line line0 = line.new(x1=startX, y1=fib_0, x2=endX, y2=fib_0, xloc=xloc.bar_index, color=color.new(fibColor, 50), style=line.style_dashed, width=1)
    array.push(fibLines, line0)
    if i_showFibLabels
        label lbl0 = label.new(x=endX, y=fib_0, text="0% (" + str.tostring(fib_0, "#.##") + ")", xloc=xloc.bar_index, style=label.style_label_left, color=color.new(color.black, 100), textcolor=color.new(fibColor, 50), size=size.small)
        array.push(fibLabels, lbl0)
    
    // Draw 23.6% level
    line line236 = line.new(x1=startX, y1=fib_236, x2=endX, y2=fib_236, xloc=xloc.bar_index, color=color.new(fibColor, 50), style=line.style_dashed, width=1)
    array.push(fibLines, line236)
    if i_showFibLabels
        label lbl236 = label.new(x=endX, y=fib_236, text="23.6% (" + str.tostring(fib_236, "#.##") + ")", xloc=xloc.bar_index, style=label.style_label_left, color=color.new(color.black, 100), textcolor=color.new(fibColor, 50), size=size.small)
        array.push(fibLabels, lbl236)
    
    // Draw 38.2% level (entry zone start)
    line line382 = line.new(x1=startX, y1=fib_382, x2=endX, y2=fib_382, xloc=xloc.bar_index, color=fibColor, style=line.style_solid, width=2)
    array.push(fibLines, line382)
    entryZoneLine1 := line382
    if i_showFibLabels
        label lbl382 = label.new(x=endX, y=fib_382, text="38.2% (" + str.tostring(fib_382, "#.##") + ") - Good", xloc=xloc.bar_index, style=label.style_label_left, color=color.new(color.black, 100), textcolor=fibColor, size=size.small)
        array.push(fibLabels, lbl382)
    
    // Draw 50% level
    line line500 = line.new(x1=startX, y1=fib_500, x2=endX, y2=fib_500, xloc=xloc.bar_index, color=fibColor, style=line.style_solid, width=2)
    array.push(fibLines, line500)
    if i_showFibLabels
        label lbl500 = label.new(x=endX, y=fib_500, text="50% (" + str.tostring(fib_500, "#.##") + ") - Better", xloc=xloc.bar_index, style=label.style_label_left, color=color.new(color.black, 100), textcolor=fibColor, size=size.small)
        array.push(fibLabels, lbl500)
    
    // Draw 61.8% level (entry zone end)
    line line618 = line.new(x1=startX, y1=fib_618, x2=endX, y2=fib_618, xloc=xloc.bar_index, color=fibColor, style=line.style_solid, width=2)
    array.push(fibLines, line618)
    entryZoneLine2 := line618
    if i_showFibLabels
        label lbl618 = label.new(x=endX, y=fib_618, text="61.8% (" + str.tostring(fib_618, "#.##") + ") - Best", xloc=xloc.bar_index, style=label.style_label_left, color=color.new(color.black, 100), textcolor=fibColor, size=size.small)
        array.push(fibLabels, lbl618)
    
    // Draw 78.6% level
    line line786 = line.new(x1=startX, y1=fib_786, x2=endX, y2=fib_786, xloc=xloc.bar_index, color=color.new(fibColor, 50), style=line.style_dashed, width=1)
    array.push(fibLines, line786)
    if i_showFibLabels
        label lbl786 = label.new(x=endX, y=fib_786, text="78.6% (" + str.tostring(fib_786, "#.##") + ")", xloc=xloc.bar_index, style=label.style_label_left, color=color.new(color.black, 100), textcolor=color.new(fibColor, 50), size=size.small)
        array.push(fibLabels, lbl786)
    
    // Draw 100% level
    line line100 = line.new(x1=startX, y1=fib_100, x2=endX, y2=fib_100, xloc=xloc.bar_index, color=color.new(fibColor, 50), style=line.style_dashed, width=1)
    array.push(fibLines, line100)
    if i_showFibLabels
        label lbl100 = label.new(x=endX, y=fib_100, text="100% (" + str.tostring(fib_100, "#.##") + ")", xloc=xloc.bar_index, style=label.style_label_left, color=color.new(color.black, 100), textcolor=color.new(fibColor, 50), size=size.small)
        array.push(fibLabels, lbl100)
    
    // Draw entry zone fill
    if i_showEntryZone and not na(entryZoneLine1) and not na(entryZoneLine2)
        entryZoneFill := linefill.new(entryZoneLine1, entryZoneLine2, color=i_entryZoneColor)
    
    fibsDrawn := true

// Update fib line extensions on each bar
if fibsDrawn and array.size(fibLines) > 0
    // If market is closed, snap to the close bar. During market hours, follow the current bar.
    // This prevents the lines from extending into "future" space (the next day).
    int targetEndX = na(marketCloseBarToday) ? bar_index : marketCloseBarToday
    
    for i = 0 to array.size(fibLines) - 1
        line currentLine = array.get(fibLines, i)
        line.set_x2(currentLine, targetEndX)
    
    for i = 0 to array.size(fibLabels) - 1
