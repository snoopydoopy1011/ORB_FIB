f_toSessionStr(int hhmm) =>
    string hourStr = str.tostring(math.floor(hhmm / 100))
    string minStr = str.tostring(hhmm % 100)
    hourStr := str.length(hourStr) == 1 ? "0" + hourStr : hourStr
    minStr := str.length(minStr) == 1 ? "0" + minStr : minStr
    hourStr + minStr

f_buildSession(int startHHMM, int endHHMM) =>
    f_toSessionStr(startHHMM) + "-" + f_toSessionStr(endHHMM)

f_getTablePosition(string pos) =>
    switch pos
        "top_right" => position.top_right
        "top_left" => position.top_left
        "bottom_right" => position.bottom_right
        "bottom_left" => position.bottom_left
        => position.top_right

f_getWinColor(float pct) =>
    na(pct) ? color.gray : pct >= 60 ? color.green : pct >= 50 ? color.yellow : color.red

// Swing High detection function
f_isSwingHigh(int strength) =>
    bool isHigh = true
    float pivotHigh = high[strength]
    for i = 1 to strength
        if high[strength + i] >= pivotHigh
            isHigh := false
            break
    for i = 1 to strength
        if high[strength - i] >= pivotHigh
            isHigh := false
            break
    isHigh

// Swing Low detection function
f_isSwingLow(int strength) =>
    bool isLow = true
    float pivotLow = low[strength]
    for i = 1 to strength
        if low[strength + i] <= pivotLow
            isLow := false
            break
    for i = 1 to strength
        if low[strength - i] <= pivotLow
            isLow := false
            break
    isLow

