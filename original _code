bool inEODCheckWindow = not na(time(timeframe.period, eodCheckSession, i_timezone))
bool isBiasCheckBar = inBiasCheckWindow and not inBiasCheckWindow[1]
bool isEODCheckBar = inEODCheckWindow and not inEODCheckWindow[1]

bool newDay = isRTH and not isRTH[1]

// ═══════════════════════════════════════════════════════════════════════════════
