                    priceVsZone := "Below Zone"
                    zoneColor := color.red
            else
                if close < fib_382
                    priceVsZone := "Below Zone"
                    zoneColor := color.gray
                else if close <= fib_618
                    priceVsZone := "★ IN ZONE ★"
                    zoneColor := color.green
                else
                    priceVsZone := "Above Zone"
                    zoneColor := color.red
            
            table.cell(dashboard, 0, row, "Price", text_color=color.white, text_size=size.tiny)
            table.cell(dashboard, 1, row, priceVsZone, text_color=zoneColor, text_size=size.tiny)
            row += 1

    // Fib Stats block
    table.cell(dashboard, 0, row, "─────────", text_color=color.gray, text_size=size.tiny)
    table.cell(dashboard, 1, row, "─────────", text_color=color.gray, text_size=size.tiny)
    row += 1

    table.cell(dashboard, 0, row, "Fib Stats", text_color=color.white, text_size=size.tiny)
    table.cell(dashboard, 1, row, "Post-ORB", text_color=color.gray, text_size=size.tiny)
