    table.cell(dashboard, 0, row, "Zone Entries ≥38", text_color=color.white, text_size=size.tiny)
    table.cell(dashboard, 1, row, zoneEntriesText, text_color=color.white, text_size=size.tiny)
    row += 1

    table.cell(dashboard, 0, row, "Win ≥38", text_color=color.white, text_size=size.tiny)
    table.cell(dashboard, 1, row, win38Text, text_color=win38Color, text_size=size.tiny)
    row += 1

    table.cell(dashboard, 0, row, "Win ≥50", text_color=color.white, text_size=size.tiny)
    table.cell(dashboard, 1, row, win50Text, text_color=win50Color, text_size=size.tiny)
    row += 1

    table.cell(dashboard, 0, row, "Win ≥61", text_color=color.white, text_size=size.tiny)
    table.cell(dashboard, 1, row, win61Text, text_color=win61Color, text_size=size.tiny)
    row += 1

    table.cell(dashboard, 0, row, "Win ≥78", text_color=color.white, text_size=size.tiny)
    table.cell(dashboard, 1, row, win78Text, text_color=win78Color, text_size=size.tiny)
    row += 1

    table.cell(dashboard, 0, row, "Blow-Through", text_color=color.white, text_size=size.tiny)
    table.cell(dashboard, 1, row, blowThroughText, text_color=blowThroughColor, text_size=size.tiny)
    row += 1
    else
        table.cell(dashboard, 0, row, "Fib Setup", text_color=color.white, text_size=size.tiny)
        table.cell(dashboard, 1, row, "Disabled", text_color=color.gray, text_size=size.tiny)
        row += 1

    // Session Status
    string orStatus = inMeanWindow ? "📊 Mean Window" : inORWindow ? "📊 OR Window" : orComplete ? "✓ OR Complete" : "⏸ Pre-Market"
    color orStatusColor = inMeanWindow ? color.yellow : inORWindow ? color.orange : orComplete ? color.green : color.gray
    table.cell(dashboard, 0, row, "Session", text_color=color.white, text_size=size.tiny)
    table.cell(dashboard, 1, row, orStatus, text_color=orStatusColor, text_size=size.tiny)

