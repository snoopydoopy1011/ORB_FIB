bool fibMonitoringActive = fibsDrawn and isRTH

// Count fib setup day once
if fibMonitoringActive and not fibSessionCountedToday
    totalFibSetups += 1
    fibSessionCountedToday := true

// Track strict touches
if fibMonitoringActive
    if breakoutState == 1
        if low <= fib_382
            touched38Today := true
        if low <= fib_500
            touched50Today := true
        if low <= fib_618
            touched61Today := true
        if low <= fib_786
            touched78Today := true
    else if breakoutState == -1
        if high >= fib_382
            touched38Today := true
        if high >= fib_500
            touched50Today := true
        if high >= fib_618
            touched61Today := true
        if high >= fib_786
            touched78Today := true

    // Cascading confirmations
    if touched78Today
        touched61Today := true
        touched50Today := true
        touched38Today := true
    else if touched61Today
        touched50Today := true
        touched38Today := true

    // Resolution checks
    if not fibResolvedToday
        bool touch0 = breakoutState == 1 ? high >= fib_0 : low <= fib_0
        bool touch100 = breakoutState == 1 ? low <= fib_100 : high >= fib_100

        if touch0 and touch100
            fibResultToday := -1
            fibResolvedToday := true
        else if touch100
            fibResultToday := -1
            fibResolvedToday := true
        else if touch0
            fibResultToday := 1
            fibResolvedToday := true

// Commit daily fib stats at resolution or end of session
bool fibCommitTrigger = fibSessionCountedToday and not fibStatsCommittedToday and (fibResolvedToday or isEODCheckBar or (not isRTH and isRTH[1]))

if fibCommitTrigger
    if touched38Today
        countTouch38 += 1
    if touched50Today
        countTouch50 += 1
    if touched61Today
        countTouch61 += 1
    if touched78Today
        countTouch78 += 1

    if fibResolvedToday
        if fibResultToday == 1
            totalWins += 1
            if touched38Today
                winsFrom38 += 1
            if touched50Today
                winsFrom50 += 1
            if touched61Today
                winsFrom61 += 1
            if touched78Today
                winsFrom78 += 1
        else if fibResultToday == -1
            totalLosses += 1
            if touched38Today
                totalFailures += 1
    else
        totalOpens += 1

    fibStatsCommittedToday := true

