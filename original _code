// Helper function to add minutes to HHMM format
f_addMinutes(int hhmm, int mins) =>
    int totalMins = math.floor(hhmm / 100) * 60 + (hhmm % 100) + mins
    int newHour = math.floor(totalMins / 60)
    int newMin = totalMins % 60
    newHour * 100 + newMin

