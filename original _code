// VOLUME PROFILE CALCULATION
// ═══════════════════════════════════════════════════════════════════════════════

bool inVPWindow = i_vpPeriod == "Session" ? isRTH : inORWindow

var array<float> vpVolumes = array.new_float(i_vpBins, 0.0)
var float vpHighest = na
var float vpLowest = na
var float pocPrice = na
var float vahPrice = na
var float valPrice = na
var int pocIndex = 0
var int vahIndex = 0
var int valIndex = 0
var bool vpCalculated = false

if newDay
    array.fill(vpVolumes, 0.0)
    vpHighest := na
    vpLowest := na
    pocPrice := na
    vahPrice := na
    valPrice := na
    pocIndex := 0
    vahIndex := 0
    valIndex := 0
    vpCalculated := false

if inVPWindow and i_showVP
    vpHighest := na(vpHighest) ? high : math.max(vpHighest, high)
    vpLowest := na(vpLowest) ? low : math.min(vpLowest, low)
    
    if not na(vpHighest) and not na(vpLowest) and vpHighest > vpLowest
        float priceRange = vpHighest - vpLowest
        float binSize = priceRange / i_vpBins
        
        for i = 0 to i_vpBins - 1
            float binLow = vpLowest + i * binSize
            float binHigh = binLow + binSize
            
            if high >= binLow and low <= binHigh
                float overlapLow = math.max(low, binLow)
                float overlapHigh = math.min(high, binHigh)
                float overlapRatio = (overlapHigh - overlapLow) / (high - low)
                overlapRatio := high == low ? 1.0 : overlapRatio
                overlapRatio := math.max(0.0, math.min(1.0, overlapRatio))
                
                float volumeToAdd = volume * overlapRatio
                array.set(vpVolumes, i, array.get(vpVolumes, i) + volumeToAdd)

bool shouldCalculateVP = i_showVP and not na(vpHighest) and not na(vpLowest) and vpHighest > vpLowest
bool vpTrigger = i_vpPeriod == "Opening Range" ? (not inORWindow and inORWindow[1]) : isRTH

if shouldCalculateVP and vpTrigger
    float maxVol = 0.0
    pocIndex := 0
    
    for i = 0 to i_vpBins - 1
        float vol = array.get(vpVolumes, i)
        if vol > maxVol
            maxVol := vol
            pocIndex := i
    
    float binSize = (vpHighest - vpLowest) / i_vpBins
    pocPrice := vpLowest + pocIndex * binSize + binSize / 2
    
    float totalVol = array.sum(vpVolumes)
    float targetVol = totalVol * i_vaPercent / 100
    
    vahIndex := pocIndex
    valIndex := pocIndex
    float capturedVol = array.get(vpVolumes, pocIndex)
    
    while capturedVol < targetVol and (valIndex > 0 or vahIndex < i_vpBins - 1)
        float volAbove = vahIndex < i_vpBins - 1 ? array.get(vpVolumes, vahIndex + 1) : 0.0
        float volBelow = valIndex > 0 ? array.get(vpVolumes, valIndex - 1) : 0.0
        
        if volAbove >= volBelow and vahIndex < i_vpBins - 1
            vahIndex += 1
            capturedVol += volAbove
        else if valIndex > 0
            valIndex -= 1
            capturedVol += volBelow
        else if vahIndex < i_vpBins - 1
            vahIndex += 1
            capturedVol += volAbove
        else
            break
    
    vahPrice := vpLowest + (vahIndex + 1) * binSize
    valPrice := vpLowest + valIndex * binSize
    
    vpCalculated := true

